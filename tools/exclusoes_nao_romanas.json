{
  "_comentario": "Regras (sobre texto sem acento e em minúsculas) para tirar da base os templos que NÃO são da Igreja Católica Apostólica Romana. 'Região/Residência Episcopal' e paróquias 'São Pio X' (o santo) são romanas e NÃO são excluídas.",
  "grupos": {
    "ICAB / Igreja Católica Apostólica Brasileira": {
      "nome": ["\\bicab\\b", "catolic\\w*\\s+apostolic\\w*\\s+(do\\s+)?brasil", "catolic\\w*\\s+brasileir", "\\bigreja\\s+brasileira\\b"],
      "site": ["(^|[^a-z])icab([^a-z]|$)", "igrejabrasileira"]
    },
    "Ortodoxas (inclui 'Católica Ortodoxa')": {
      "nome": ["ortodox"],
      "site": ["ortodox"]
    },
    "Anglicanas / Episcopais": {
      "nome": ["anglican", "\\bigreja\\s+episcopal\\b", "episcopal\\s+(anglican|sul|carismatic)"],
      "site": ["anglican"]
    },
    "'Católicas' independentes (antiga, livre, liberal, nacional, carismática...)": {
      "nome": ["catolic\\w*\\s+(antiga|livre|liberal|independente|nacional|gnostic\\w*|evangelic\\w*)", "catolic\\w*\\s+apostolic\\w*\\s+(independente|carismatic\\w*|ortodox\\w*|nacional|livre|evangelic\\w*|gnostic\\w*)"],
      "site": ["catolicaantiga", "padrejosemar"]
    },
    "Pentecostais / evangélicas que usam 'apostólica' ou 'catedral'": {
      "nome": ["milagres\\s+apostolic", "apostolic\\w*.*(avivamento|fogo|pentecost)", "(avivamento|fogo|pentecost).*apostolic"],
      "site": []
    },
    "Tradicionalistas fora da comunhão (FSSPX / Sociedade Sacerdotal São Pio X)": {
      "nome": ["tradicionalista", "lefebvr", "\\bfsspx\\b", "(sociedade|fraternidade)\\s+sacerdotal\\s+sao\\s+pio\\s+x"],
      "site": ["fsspx", "fsspx"]
    }
  }
}
